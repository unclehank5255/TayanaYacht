@model TayanaYacht.Models.Dealer.Dealer
@using TayanaYacht.Models;

@{
    ViewBag.Title = "刪除經銷商";
}
<h2>@ViewBag.Title</h2>
<h3>確定要刪除這個經銷商嗎？</h3>
<div>
    <hr />
    <dl class="dl-horizontal">
        <dt>
            @Html.DisplayNameFor(model => model.Country.Name)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Country.Name)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.DealerCoverPath)
        </dt>

        <dd>
            <img class="banner-thumb" src="@(Model.DealerCoverPath ?? ImageDefaults.Picture)" />
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.Name)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Name)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.City)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.City)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.ContentHtml)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.ContentHtml)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.DisplayOrder)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.DisplayOrder)
        </dd>

    </dl>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="form-group my-2">
            <input type="submit" value="刪除" class="btn btn-danger me-1");" />
            @Html.ActionLink("返回", "Index", null, new { @class = "btn btn-outline-secondary" })
        </div>
    }
</div>
