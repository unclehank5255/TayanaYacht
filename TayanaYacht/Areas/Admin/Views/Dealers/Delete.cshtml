@model TayanaYacht.Models.Dealer.Dealer
@using TayanaYacht.Models;

@{
    ViewBag.Title = "刪除經銷商";
}

<h2 class="my-2">@ViewBag.Title</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-warning">@TempData["Message"]</div>
}

<div class="alert alert-warning">
    確定要刪除這間經銷商嗎？刪除後前台不會顯示，後台列表也看不到。
</div>
<div class="card mb-3">
    <div class="card-body d-flex align-items-center gap-3">
        <img class="banner-thumb" src="@(Model.DealerCoverPath ?? ImageDefaults.Picture)" />
        <div>
            <div class="fw-semibold">@Model.Country.Name</div>
            <div class="text-muted small mb-1">@Model.City</div>
            <div class="text-muted small mb-1">@Model.Name</div>
        </div>
    </div>
</div>


@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-group my-2">
        <input type="submit" value="刪除" class="btn btn-danger me-1" );" />
        @Html.ActionLink("返回取消", "Index", null, new { @class = "btn btn-outline-secondary" })
    </div>
}

