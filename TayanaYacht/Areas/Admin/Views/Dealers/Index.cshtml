@model IEnumerable<TayanaYacht.Models.Dealer.Dealer>
@using TayanaYacht.Models;
@{
    var dealers = Model.ToList();
    ViewBag.Title = "經銷商管理";
    var countryCount = dealers.Select(d => d.CountryId).Distinct().Count();
    var noCoverCount = dealers.Count(d => string.IsNullOrEmpty(d.DealerCoverPath));
}
<script>
    var targetInputId;

    function openPicturePicker(tag, inputId) {
        targetInputId = inputId;
        var url = '/Admin/FileManager'
            + '?type=DealerPage'
            + '&id=1'
            + '&tag=' + tag;

        window.open(url, 'fileManager', 'width=1100,height=700');
    }

    function onFilePicked(path) {
        var input = document.getElementById(targetInputId);
        input.value = path;
        document.getElementById('bannerPreview').src = path;
        input.form.submit();
    }
</script>
<div class="d-flex gap-3 align-items-start mb-3">
    <div class="flex-shrink-0">
        <h2 class="my-2">@ViewBag.Title</h2>
        <p class="text-muted ">
            目前共 @Model.Count() 家經銷商，分佈在 <span class="badge bg-secondary">@countryCount</span>  個國家，共 <span class="badge bg-warning">@noCoverCount</span>  家尚未設定封面
        </p>
        <div class="d-flex gap-2 mb-3">
            @Html.ActionLink("新增經銷商", "Create", null, new { @class = "btn btn-primary" })
            @Html.ActionLink("國家管理", "Index", "Countries", null, new { @class = "btn btn-outline-secondary" })
        </div>
    </div>
    <div class="card  flex-grow-1">
        <div class="row g-0">
            <div class="col-md-4">
                <div class="card-body">
                    <h6 class="my-2">經銷商頁橫幅</h6>
                    <p class="small text-muted pb-2">前台經銷商頁最上方的大圖</p>
                    @using (Html.BeginForm("UpdatePageBanner", "Dealers", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="BannerPath" value="@ViewBag.BannerPath" id="bannerImagePath" />
                        <button type="button" class="btn btn-sm btn-outline-primary"
                                onclick="openPicturePicker('DealerBannerPicture', 'bannerImagePath')">
                            選擇橫幅圖片
                        </button>
                    }
                </div>
            </div>
            <div class="col-md-8">
                <img src="@(ViewBag.BannerPath ?? ImageDefaults.Picture)" id="coverPreview" class="banner-card-img rounded-end" />
            </div>
        </div>
    </div>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-warning">@TempData["Message"]</div>
}
<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.DisplayOrder)</th>
                    <th>@Html.DisplayNameFor(model => model.DealerCoverPath)</th>
                    <th> @Html.DisplayNameFor(model => model.Name)</th>
                    <th>@Html.DisplayNameFor(model => model.Country.Name)</th>
                    <th>@Html.DisplayNameFor(model => model.City)</th>
                    <th class="text-end">操作</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in dealers)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.DisplayOrder)</td>
                        <td><img class="banner-thumb" src="@(item.DealerCoverPath ?? ImageDefaults.Picture)" /></td>
                        <td> @Html.DisplayFor(modelItem => item.Name)</td>
                        <td>@Html.DisplayFor(modelItem => item.Country.Name)</td>
                        <td>@Html.DisplayFor(modelItem => item.City)</td>
                        <td class="text-end text-nowrap">
                            @Html.ActionLink("編輯", "Edit", new { id = item.Id }, new { @class = "btn btn-sm btn-outline-primary " })
                            @Html.ActionLink("刪除", "Delete", new { id = item.Id }, new { @class = "btn btn-sm btn-outline-danger" })
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>