@model TayanaYacht.Models.Contact.ContactMessage
@{
    ViewBag.Title = "刪除留言";
}

<h2 class="my-2">@ViewBag.Title</h2>

<div class="alert alert-warning">
    確定要刪除這則留言嗎？刪除後無法復原。
</div>

<div class="card mb-3">
    <div class="card-header d-flex align-items-center">
        <span>@Model.Name 的留言</span>
        @if (Model.HandledAt == null)
        {
            <span class="badge bg-danger mx-auto">未處理</span>
        }
        else
        {
            <span class="badge bg-secondary mx-auto">已處理</span>
        }
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-2">@Html.DisplayNameFor(m => m.SubmittedAt)</dt>
            <dd class="col-sm-10">@Html.DisplayFor(m => m.SubmittedAt)</dd>

            <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Email)</dt>
            <dd class="col-sm-10">@Html.DisplayFor(m => m.Email)</dd>

            <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Comment)</dt>
            <dd class="col-sm-10" style="white-space: pre-wrap;">@Model.Comment</dd>
        </dl>
    </div>
</div>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-danger">確定刪除</button>
        @Html.ActionLink("取消", "Details", new { id = Model.Id }, new { @class = "btn btn-outline-secondary" })
    </div>
}