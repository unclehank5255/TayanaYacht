@model IEnumerable<TayanaYacht.Models.Contact.ContactMessage>
@{
    ViewBag.Title = "留言管理";
    var unhandledCount = Model.Count(m => m.HandledAt == null);
}

<h2 class="my-2">@ViewBag.Title</h2>
<p class="text-muted">
    共 @Model.Count() 則，未處理 <span class="badge bg-danger">@unhandledCount</span>
</p>

@if (TempData["Message"] != null)
{
    <div class="alert alert-info">@TempData["Message"]</div>
}

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>狀態</th>
                    <th>提交時間</th>
                    <th>姓名</th>
                    <th>聯絡方式</th>
                    <th>國家</th>
                    <th>遊艇</th>
                    <th>留言</th>
                    <th class="text-end">操作</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">目前沒有留言</td>
                    </tr>
                }

                @foreach (var item in Model)
                {
                    var comment = item.Comment ?? "";
                    var shortComment = comment.Length > 30 ? comment.Substring(0, 30) + "…" : comment;

                    <tr class="@(item.HandledAt == null ? "fw-semibold" : "text-muted")">
                        <td>
                            @if (item.HandledAt == null)
                            {
                                <span class="badge bg-danger">未處理</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">已處理</span>
                            }
                        </td>
                        <td class="text-nowrap">@item.SubmittedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@item.Name</td>
                        <td>
                            <a href="mailto:@item.Email">@item.Email</a><br />
                            <small>@item.Phone</small>
                        </td>
                        <td>@item.Country</td>
                        <td>@item.YachtNameSnapshot</td>
                        <td title="@comment">@shortComment</td>
                        <td class="text-end text-nowrap">
                            @Html.ActionLink("查看", "Details", new { id = item.Id }, new { @class = "btn btn-sm btn-outline-secondary" })

                            @if (item.HandledAt == null)
                            {
                                using (Html.BeginForm("MarkHandled", "ContactMessages", new { id = item.Id }, FormMethod.Post, new { @class = "d-inline" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-success">標記已處理</button>
                                }
                            }

                            @Html.ActionLink("刪除", "Delete", new { id = item.Id }, new { @class = "btn btn-sm btn-outline-danger" })
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>