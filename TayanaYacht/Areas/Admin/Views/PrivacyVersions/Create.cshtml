@model TayanaYacht.Models.Contact.PrivacyVersion

@{
    ViewBag.Title = "新增隱私版本";
}
@section scripts {
    @*adminlte*@
    @Scripts.Render("~/bundles/jqueryval")
    @*ckeditor*@
    @Scripts.Render("~/bundles/ckeditor")


    <script>
        CKEDITOR.replace('ContentHtml', {
            language: 'zh-tw',
            versionCheck: false,
        });
    </script>
}

<h2 class="my-2">@ViewBag.Title</h2>
<div class="alert alert-info">
    填入版本名稱和內容即可新增。新增隱私版本預設為<strong>未上架</strong>。
</div>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="card mb-3">
        <div class="card-header">版本管理</div>
        <div class="card-body">
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            <div class="mb-3">
                @Html.LabelFor(model => model.Title, htmlAttributes: new { @class = "control-label col-md-2" })
                @Html.EditorFor(model => model.Title, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.ContentHtml, htmlAttributes: new { @class = "control-label col-md-2" })
                @Html.TextAreaFor(model => model.ContentHtml, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.ContentHtml, "", new { @class = "text-danger" })
            </div>

        </div>
    </div>
    <div class="form-group my-2">
        <input type="submit" value="儲存" class="btn btn-primary me-1" />
        @Html.ActionLink("返回列表", "Index", null, new { @class = "btn btn-outline-secondary" })
    </div>
}
