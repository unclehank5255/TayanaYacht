@model TayanaYacht.Models.Contact.PrivacyVersion

@{
    ViewBag.Title = "隱私條款詳細";
}

<h2>@ViewBag.Title</h2>
<p class="text-muted ">
    正在查看「@Model.Title」的隱私文本        
    @if (Model.PublishedAt == null)
    {
        <span class="badge bg-warning text-dark ms-auto">草稿</span>
    }
    else
    {
        <span class="badge bg-success ms-auto">已發布</span>
    }
</p>
<div class="d-flex gap-2 mb-3">
    @Html.ActionLink("返回列表", "Index", null, new { @class = "btn btn-outline-secondary" })
</div>

<div class="card mb-3">
    <div class="card-header d-flex align-items-center">
        <span class="fw-bold">@Model.Title</span>
    </div>

    <div class="card-body">
        <p class="text-muted small mb-3">
            建立時間：@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")
            @if (Model.PublishedAt != null)
            {
                <span class="ms-3">發布時間：@Model.PublishedAt.Value.ToString("yyyy-MM-dd HH:mm")</span>
            }
        </p>

        <div class="border rounded p-3 bg-light">
            @Html.Raw(Model.ContentHtml)
        </div>
    </div>
</div>
<div class="d-flex gap-2 mb-3">
    @if (Model.PublishedAt == null)
    {
        @Html.ActionLink("編輯", "Edit", new { id = Model.Id }, new { @class = "btn btn-outline-primary" })
    }
    @Html.ActionLink("返回列表", "Index", null, new { @class = "btn btn-outline-secondary" })
</div>
