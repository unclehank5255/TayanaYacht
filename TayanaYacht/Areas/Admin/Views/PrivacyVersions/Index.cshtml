@model IEnumerable<TayanaYacht.Models.Contact.PrivacyVersion>

@{
    ViewBag.Title = "隱私版本管理";
    int? activeId = ViewBag.ActiveVersionId;
}

<h2 class="my-2">@ViewBag.Title</h2>
<p class="text-muted">
    目前共有 @Model.Where(c => c.PublishedAt != null).Count() 則隱私條款版本，要注意⚠發佈後將不能修改文本
</p>

<div class="d-flex gap-2 mb-3">
    @Html.ActionLink("新增隱私版本", "Create", null, new { @class = "btn btn-primary" })
</div>



@if (TempData["Message"] != null)
{
    <div class="alert alert-warning">@TempData["Message"]</div>
}
<div class="card mb-3">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Title)</th>
                    <th>@Html.DisplayNameFor(model => model.CreatedAt)</th>
                    <th>狀態</th>
                    <th>@Html.DisplayNameFor(model => model.PublishedAt)</th>
                    <th>操作</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    string status; if (item.PublishedAt == null) { status = "草稿"; } else if (item.Id == activeId) { status = "使用中"; } else { status = "已取代"; }
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.Title)</td>
                        <td>@Html.DisplayFor(modelItem => item.CreatedAt)</td>
                        <td>@status</td>
                        <td> @Html.DisplayFor(modelItem => item.PublishedAt)</td>
                        <td>
                            @if (item.PublishedAt == null)
                            {
                                @Html.ActionLink("編輯", "Edit", new { id = item.Id }, new { @class = "btn btn-sm btn-outline-primary " })
                            }
                            else
                            {
                                @Html.ActionLink("編輯", "Edit", new { id = item.Id }, new { @class = "btn btn-sm btn-outline-secondary" })
                            }
                            @Html.ActionLink("查看", "Details", new { id = item.Id }, new { @class = "btn btn-sm btn-outline-primary " })
                            @if (item.PublishedAt == null)
                            {
                                @Html.ActionLink("刪除", "Delete", new { id = item.Id }, new { @class = "btn btn-sm btn-outline-danger " })
                            }
                            else
                            {
                                @Html.ActionLink("刪除", "Delete", new { id = item.Id }, new { @class = "btn btn-sm btn-outline-secondary" })
                            }
                            @using (Html.BeginForm("Publish", "PrivacyVersions", new { id = item.Id }, FormMethod.Post,
                            new { @class = "d-inline", onsubmit = "return confirm('發布後就不能修改或刪除，確定要發布嗎？');" }))
                            {
                                @Html.AntiForgeryToken()
                                if (item.PublishedAt == null)
                                {
                                    <button type="submit" class="btn btn-sm btn-success">發布</button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-secondary" disabled>發布</button>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
