@model TayanaYacht.Models.Yacht.Yacht

@{
    ViewBag.Title = "Edit";
}


@section scripts {
    @*adminlte*@
    @Scripts.Render("~/bundles/jqueryval")
    @*ckeditor*@
    @Scripts.Render("~/bundles/ckeditor")

    <script>

    CKEDITOR.replace('OverviewHtml', {
        filebrowserBrowseUrl: '/Admin/FileManager?type=Yacht&id=@Model.Id&tag=HtmlEditorPicture',
        language: 'zh-tw',
        versionCheck: false
    });
    CKEDITOR.replace('PrincipleDimensionHtml', {
        filebrowserBrowseUrl: '/Admin/FileManager?type=Yacht&id=@Model.Id&tag=HtmlEditorPicture',
        language: 'zh-tw',
        versionCheck: false
        });
    CKEDITOR.replace('SpecificationHtml', {
        filebrowserBrowseUrl: '/Admin/FileManager?type=Yacht&id=@Model.Id&tag=HtmlEditorPicture',
        language: 'zh-tw',
        versionCheck: false
    });
        function openBannerPicker() {
        var url = '/Admin/FileManager'
            + '?type=Yacht'
            + '&id=@Model.Id'
            + '&tag=YachtBannerPicture';

        window.open(url, 'fileManager', 'width=1100,height=700');
    }
    </script>
}

<h2 class="my-2">@ViewBag.Title</h2>
<p class="text-muted ">
    正在編輯 @Model.SeriesName @Model.ModelName 遊艇文本，創建時間 <span class="badge bg-secondary ">@Model.CreatedAt</span> ，上次更新時間 <span class="badge bg-info ">@Model.UpdatedAt</span>
</p>
@if (TempData["Message"] != null)
{
    <div class="alert alert-success">
        @TempData["Message"]
    </div>
}
<div class="my-2">
    @Html.ActionLink("返回列表", "Index", null, new { @class = "btn btn-outline-secondary" })
</div>
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.Id)

    <div class="card mb-3">
        <div class="card-header">基本資訊</div>
        <div class="card-body">
            <div class="mb-3">
                @Html.LabelFor(model => model.SeriesName, new { @class = "form-label" })
                @Html.EditorFor(model => model.SeriesName, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.SeriesName, "", new { @class = "text-danger" })
            </div>
            <div class="mb-3">
                @Html.LabelFor(model => model.ModelName, new { @class = "form-label" })
                @Html.EditorFor(model => model.ModelName, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.ModelName, "", new { @class = "text-danger" })
            </div>
            <div>
                @Html.LabelFor(model => model.StatusText, new { @class = "form-label" })
                @Html.EditorFor(model => model.StatusText, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.StatusText, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">發布設定</div>
        <div class="card-body">
            <div class="form-check mb-2">
                @Html.CheckBoxFor(model => model.IsLatest, new { @class = "form-check-input" })
                @Html.LabelFor(model => model.IsLatest, new { @class = "form-check-label" })
            </div>
            <div class="form-check">
                @Html.CheckBoxFor(model => model.IsPublished, new { @class = "form-check-input" })
                @Html.LabelFor(model => model.IsPublished, new { @class = "form-check-label" })
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">@Html.DisplayNameFor(model => model.OverviewHtml)</div>
        <div class="card-body">
            @Html.TextAreaFor(model => model.OverviewHtml, new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.OverviewHtml, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">@Html.DisplayNameFor(model => model.PrincipleDimensionHtml)</div>
        <div class="card-body">
            @Html.TextAreaFor(model => model.PrincipleDimensionHtml, new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.PrincipleDimensionHtml, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">@Html.DisplayNameFor(model => model.SpecificationHtml)</div>
        <div class="card-body">
            @Html.TextAreaFor(model => model.SpecificationHtml, new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.SpecificationHtml, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="d-flex gap-2 mb-3">
        <input type="submit" value="儲存" class="btn btn-primary" />
        @Html.ActionLink("返回列表", "Index", null, new { @class = "btn btn-outline-secondary" })
    </div>
}


