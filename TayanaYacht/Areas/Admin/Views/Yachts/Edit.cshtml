@model TayanaYacht.Models.Yacht.Yacht

@{
    ViewBag.Title = "Edit";
}


@section scripts {
    @*adminlte*@
    @Scripts.Render("~/bundles/jqueryval")
    @*ckeditor*@
    @Scripts.Render("~/bundles/ckeditor")

    <script>

    CKEDITOR.replace('OverviewHtml', {
        filebrowserBrowseUrl: '/Admin/FileManager?type=Yacht&id=@Model.Id&tag=HtmlEditorPicture',
        language: 'zh-tw',
        versionCheck: false
    });
    CKEDITOR.replace('PrincipleDimensionHtml', {
        filebrowserBrowseUrl: '/Admin/FileManager?type=Yacht&id=@Model.Id&tag=HtmlEditorPicture',
        language: 'zh-tw',
        versionCheck: false
        });
    CKEDITOR.replace('SpecificationHtml', {
        filebrowserBrowseUrl: '/Admin/FileManager?type=Yacht&id=@Model.Id&tag=HtmlEditorPicture',
        language: 'zh-tw',
        versionCheck: false
    });
    </script>
}
<h2>Edit</h2>

<script>
    function openBannerPicker() {
        var url = '/Admin/FileManager'
            + '?type=Yacht'
            + '&id=@Model.Id'
            + '&tag=YachtBannerPicture';

        window.open(url, 'fileManager', 'width=1100,height=700');
    }
</script>
<p>
    @Html.ActionLink("[反回 Index]", "Index")
</p>
