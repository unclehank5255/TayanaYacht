@model IEnumerable<TayanaYacht.Models.Yacht.Yacht>

@{
    ViewBag.Title = "Index";
}

<h2>Index</h2>

<p>
    @Html.ActionLink("[＋新增 Yacht]", "Create")
</p>
<table class="table">
    <tr>
        <th>
            圖片
            @*@Html.DisplayNameFor(model => model.YachtBannerPath)*@
        </th>
        <th>
            名稱
            @*@Html.DisplayNameFor(model => model.SeriesName)
            @Html.DisplayNameFor(model => model.ModelName)*@
        </th>
        <th>
            狀態
            @*@Html.DisplayNameFor(model => model.StatusText)*@
        </th>

        <th>
            排序
            @*@Html.DisplayNameFor(model => model.DisplayOrder)*@
        </th>
        <th>
            最新?
            @*@Html.DisplayNameFor(model => model.IsLatest)*@
        </th>

        <th>操作</th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.Raw(item.YachtBannerPath)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.SeriesName)
            @Html.DisplayFor(modelItem => item.ModelName)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.StatusText)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.DisplayOrder)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.IsLatest)
        </td>
        <td>
            @Html.ActionLink("Edit", "Edit", new { id = item.Id }) |
            @Html.ActionLink("Details", "Details", new { id = item.Id }) |
            @Html.ActionLink("Delete", "Delete", new { id = item.Id })
        </td>
    </tr>
}

</table>
