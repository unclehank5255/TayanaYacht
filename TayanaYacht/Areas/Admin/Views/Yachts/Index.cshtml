@model IEnumerable<TayanaYacht.Models.Yacht.Yacht>
@using TayanaYacht.Models

@{
    ViewBag.Title = "遊艇管理";
    var yachts = Model.ToList();
}
@section scripts {
    @Scripts.Render("~/Scripts/admin-yacht")
}

<h2 class="my-2">@ViewBag.Title</h2>
<p class="text-muted ">
    目前共 <span class="badge bg-secondary bg-gradient">@Model.Count()</span> 艘船在貨架上
</p>
<div class="d-flex gap-2 mb-3">
    @Html.ActionLink("新增遊艇", "Create", null, new { @class = "btn btn-primary" })
    @Html.ActionLink("已下架遊艇", "Deleted", null, new { @class = "btn btn-outline-secondary" })
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-warning">@TempData["Message"]</div>
}

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>順序</th>
                    <th>封面</th>
                    <th>系列／型號</th>
                    <th>@Html.DisplayNameFor(model => model.StatusText)</th>
                    <th>標籤</th>
                    <th>@Html.DisplayNameFor(model => model.DisplayOrder)</th>
                    <th class="text-end">操作</th>
                </tr>
            </thead>
            <tbody>
                @if (!yachts.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">目前沒有遊艇</td>
                    </tr>
                }

                @for (int i = 0; i < yachts.Count; i++)
                {
                    var item = yachts[i];

                    <tr>
                        <td>@(i + 1)</td>
                        <td>
                            <img class="banner-thumb" src="@(item.YachtBannerPath ?? ImageDefaults.Picture)" />
                        </td>
                        <td>@item.SeriesName @item.ModelName</td>
                        <td>@item.StatusText</td>
                        <td>
                            @if (item.IsPublished)
                            {
                                <span class="badge bg-success">已發布</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">未發布</span>
                            }
                            @if (item.IsLatest)
                            {
                                <span class="badge bg-info">最新款</span>
                            }
                        </td>
                        <td>
                            @using (Html.BeginForm("MoveYachts", "Yachts", FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <div class="d-flex flex-column gap-1">
                                    <button type="submit" name="direction" value="up"
                                            class="btn btn-sm btn-outline-secondary" disabled="@(i == 0)">
                                        <i class="bi bi-arrow-up"></i> 往上
                                    </button>
                                    <button type="submit" name="direction" value="down"
                                            class="btn btn-sm btn-outline-secondary" disabled="@(i == yachts.Count - 1)">
                                        <i class="bi bi-arrow-down"></i> 往下
                                    </button>
                                </div>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            @Html.ActionLink("編輯", "Edit", new { id = item.Id }, new { @class = "btn btn-sm btn-outline-primary" })
                            @Html.ActionLink("附件", "ManageAttachments", new { id = item.Id }, new { @class = "btn btn-sm btn-outline-secondary" })
                            @Html.ActionLink("下架", "Delete", new { id = item.Id }, new { @class = "btn btn-sm btn-outline-danger" })
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>