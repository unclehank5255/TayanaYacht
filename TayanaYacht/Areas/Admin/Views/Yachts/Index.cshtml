@model IEnumerable<TayanaYacht.Models.Yacht.Yacht>
@using TayanaYacht.Models

@{
    ViewBag.Title = "Index";
}

<h2>Index</h2>

<div class="yachtindex_container">
    <div>
        <p>
            @Html.ActionLink("[Add Yacht]", "Create")
        </p>
    </div>
    <div>
        <p>
            @Html.ActionLink("[Removed Yacht]", "Deleted")
        </p>
    </div>

</div>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.YachtBannerPath)
        </th>
        <th>

            @Html.DisplayNameFor(model => model.SeriesName)
            @Html.DisplayNameFor(model => model.ModelName)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.StatusText)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.DisplayOrder)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.IsLatest)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.IsPublished)
        </th>
        <th>

        </th>
        <th>操作</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                <img class="banner-thumb" src="@(item.YachtBannerPath ?? ImageDefaults.Picture)" id=@(item.Id) />
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.SeriesName)
                @Html.DisplayFor(modelItem => item.ModelName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.StatusText)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DisplayOrder)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IsLatest)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IsPublished)
            </td>
            <td>
                @using (Html.BeginForm("MoveYachts", "Yachts", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@item.Id" />
                    <div>
                        <div>
                            <button type="submit" name="direction" value="up">往上</button>
                        </div>
                        <div>
                            <button type="submit" name="direction" value="down">往下</button>
                        </div>
                    </div>
                }
            </td>
            <td>
                @Html.ActionLink("Edit", "Edit", new { id = item.Id }) |
                @Html.ActionLink("Manage Pictures", "ManagePictures", new { id = item.Id }) |
                @Html.ActionLink("Details", "Details", new { id = item.Id }) |
                @Html.ActionLink("TakeDown", "Delete", new { id = item.Id })
            </td>
        </tr>
    }

</table>
