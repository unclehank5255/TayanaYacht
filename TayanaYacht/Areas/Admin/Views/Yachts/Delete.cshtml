@model TayanaYacht.Models.Yacht.Yacht
@using TayanaYacht.Models
@{
    ViewBag.Title = "下架遊艇";
}

<h2 class="my-2">@ViewBag.Title</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-warning">@TempData["Message"]</div>
}

<div class="alert alert-warning">
    確定要下架這艘遊艇嗎？下架後前台不會顯示，也不能再編輯，可以在「已下架遊艇」查看。
</div>

<div class="card mb-3">
    <div class="card-body d-flex align-items-center gap-3">
        <img class="banner-thumb" src="@(Model.YachtBannerPath ?? ImageDefaults.Picture)" />
        <div>
            <div class="fw-semibold">@Model.SeriesName @Model.ModelName</div>
            <div class="text-muted">@Model.StatusText</div>
        </div>
    </div>
</div>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-danger">確定下架</button>
        @Html.ActionLink("取消", "Index", null, new { @class = "btn btn-outline-secondary" })
    </div>
}