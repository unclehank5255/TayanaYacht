@model IEnumerable<TayanaYacht.Models.Yacht.Yacht>
@using TayanaYacht.Models
@{
    ViewBag.Title = "已下架遊艇";
}

<h2 class="my-2">@ViewBag.Title</h2>
<p class="text-muted ">
    目前共 @Model.Count() 艘船不在貨架上
</p>
<div class="my-2">
    @Html.ActionLink("返回列表", "Index", null, new { @class = "btn btn-outline-secondary" })
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-info">@TempData["Message"]</div>
}

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>封面</th>
                    <th>系列／型號</th>
                    <th>@Html.DisplayNameFor(model => model.StatusText)</th>
                    <th>下架時間</th>
                    <th class="text-end">操作</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">目前沒有已下架的遊艇</td>
                    </tr>
                }

                @foreach (var item in Model)
                {
                    <tr class="text-muted">
                        <td>
                            <img class="banner-thumb" src="@(item.YachtBannerPath ?? ImageDefaults.Picture)" />
                        </td>
                        <td>@item.SeriesName @item.ModelName</td>
                        <td>@item.StatusText</td>
                        <td class="text-nowrap">@item.DeletedAt.Value.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="text-end text-nowrap">
                            @Html.ActionLink("查看", "Details", new { id = item.Id }, new { @class = "btn btn-sm btn-outline-secondary" })
                            @using (Html.BeginForm("Restore", "Yachts", FormMethod.Post, new { @class = "d-inline" }))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="btn btn-sm btn-success"
                                        onclick="return confirm('確定要重新上架這艘遊艇嗎？');">
                                    重新上架
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>