<div class="card mb-3">
    <div class="card-header">下載檔案（PDF）</div>
    <div class="card-body">
        @if (ViewBag.Files.Count == 0)
        {
            <p class="text-muted mb-0">尚無檔案</p>
        }
        @foreach (var file in ViewBag.Files)
        {
            <div class="d-flex align-items-center gap-2 mb-2">
                <i class="bi bi-file-earmark-pdf"></i>
                <a href="@file.FilePath" target="_blank">@file.FileOriginalName</a>
                @using (Html.BeginForm("DeleteFile", "Yachts", FormMethod.Post, new { @class = "ms-auto" }))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@file.Id" />
                    <button type="submit" class="btn btn-sm btn-outline-danger"
                            onclick="return confirm('確定要刪除檔案嗎？');">
                        刪除
                    </button>
                }
            </div>
        }
    </div>
    <div class="card-footer">
        @using (Html.BeginForm("UploadFile", "Yachts", FormMethod.Post, new { enctype = "multipart/form-data", @class = "d-flex gap-2" }))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="yachtId" value="@yacht.Id" />
            <input type="text" name="displayName" class="form-control" placeholder="顯示名稱（可留空）" />
            <input type="file" name="upload" class="form-control" accept=".pdf" />
            <button type="submit" class="btn btn-primary text-nowrap">上傳</button>
            @Html.ActionLink("返回列表", "Index", null, new { @class = "btn btn-outline-secondary" }) 
        }
    </div>
</div>