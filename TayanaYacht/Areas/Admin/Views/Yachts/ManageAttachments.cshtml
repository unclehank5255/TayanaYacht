@model List<TayanaYacht.Models.Yacht.YachtPicture>
@{
    ViewBag.Title = "ManageAttachments";
    int pictureCount = 1;
}
@section scripts {
    @Scripts.Render("~/Scripts/admin-yacht")
}

<p>
    @Html.ActionLink("[返回 Index]", "Index")
</p>
<script>
var targetInputId;
    //按下圖片打開elfinder
    function openPicturePicker(tag, inputId) {
        targetInputId = inputId;
        var url = '/Admin/FileManager'
            + '?type=Yacht'
            + '&id=@ViewBag.YachtId'
            + '&tag='+tag;

        window.open(url, 'fileManager', 'width=1100,height=700');
    }
    //elfinder回傳圖片路徑
    function onFilePicked(path) {
    var input = document.getElementById(targetInputId);
    input.value = path;
    input.form.submit();
        }

</script>
<h4>Banner</h4>
<div class="picture-item">
    <img src="@ViewBag.YachtBannerPath" />
</div>
@using (Html.BeginForm("UpdateBanner", "Yachts", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <input type="hidden" name="yachtId" value="@ViewBag.YachtId" />
    <input type="hidden" name="bannerPath" value="@ViewBag.YachtBannerPath" id="bannerImagePath" />
    <div class="banner-picker-row">
        <button type="button" onclick="openPicturePicker('YachtBannerPicture', 'bannerImagePath')">選擇Banner圖片</button>
    </div>
}

<h4>Gallery</h4>

<div class="picture-list">
    @foreach (var item in Model.Where(p => p.PictureType == TayanaYacht.Models.Yacht.YachtPictureTypeEnum.Gallery))
    {
        <div class="picture-item">
            <img src="@item.ImagePath" />
            <div>@item.PictureType 第 @pictureCount 張</div>
        </div>
        <div>
            @using (Html.BeginForm("MovePicture", "Yachts", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@item.Id" />
                <div>
                    <div>
                        <button type="submit" name="direction" value="up">往前</button>
                    </div>
                    <div>
                        <button type="submit" name="direction" value="down">往後</button>
                    </div>
                </div>
            }
            @using (Html.BeginForm("DeletePicture", "Yachts", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@item.Id" />
                <button type="submit" onclick="return confirm('確定要刪除這張圖片嗎？');">刪除</button>
            }
        </div>
        pictureCount++;
    }

</div>
@using (Html.BeginForm("AddPicture", "Yachts", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <input type="hidden" name="YachtId" value="@ViewBag.YachtId" />
    <input type="hidden" name="PictureType" value="Gallery" />
    <input type="hidden" name="ImagePath" id="galleryImagePath" />
    <div class="banner-picker-row">
        <button type="button" onclick="openPicturePicker('YachtGalleryPicture', 'galleryImagePath')">選擇Gallery圖片</button>
    </div>
}



<h4>Layout</h4>

<div class="picture-list">
    @{pictureCount = 1;}
    @foreach (var item in Model.Where(p => p.PictureType == TayanaYacht.Models.Yacht.YachtPictureTypeEnum.Layout))
    {
        <div class="picture-item">
            <img src="@item.ImagePath" />
            <div>@item.PictureType 第 @pictureCount 張</div>
        </div>
        <div>
            @using (Html.BeginForm("MovePicture", "Yachts", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@item.Id" />
                <div>
                    <div>
                        <button type="submit" name="direction" value="up">往前</button>
                    </div>
                    <div>
                        <button type="submit" name="direction" value="down">往後</button>
                    </div>
                </div>
            }
            @using (Html.BeginForm("DeletePicture", "Yachts", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@item.Id" />
                <button type="submit" onclick="return confirm('確定要刪除這張圖片嗎？');">刪除</button>
            }
        </div>
        pictureCount++;
    }
</div>

@using (Html.BeginForm("AddPicture", "Yachts", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <input type="hidden" name="YachtId" value="@ViewBag.YachtId" />
    <input type="hidden" name="PictureType" value="Layout" />
    <input type="hidden" name="ImagePath" id="layoutImagePath" />
    <div class="banner-picker-row">
        <button type="button" onclick="openPicturePicker('YachtLayoutPicture', 'layoutImagePath')">選擇Layout圖片</button>
    </div>
}


@if (TempData["Message"] != null)
{
<div class="alert alert-warning position-fixed bottom-0 end-0 m-3">
    @TempData["Message"]
</div>
}
<h4>Files</h4>
@if (ViewBag.Files.Count == 0)
{
    <p>尚無檔案</p>
}
@foreach (var file in ViewBag.Files)
{
    <div>
        <i class="bi bi-file-earmark-pdf"></i>
        <a href="@file.FilePath" target="_blank">@file.FileOriginalName</a>
        @using (Html.BeginForm("DeleteFile", "Yachts", FormMethod.Post, new { @class = "d-inline" }))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@file.Id" />
            <button type="submit" onclick="return confirm('確定要刪除檔案嗎？');">刪除</button>
        }
    </div>
}
@using (Html.BeginForm("UploadFile", "Yachts", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    <input type="hidden" name="yachtId" value="@ViewBag.YachtId" />
    <input type="text" name="displayName" placeholder="顯示名稱（可留空）" />
    <input type="file" name="upload" accept=".pdf" />
    <button type="submit">上傳</button>
}

<div>
    @Html.ActionLink("Back to List", "Index")
</div>