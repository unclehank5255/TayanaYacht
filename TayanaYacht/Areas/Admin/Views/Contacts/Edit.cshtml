@model TayanaYacht.Models.Contact.Contact
@using TayanaYacht.Models;
@{
    ViewBag.Title = "聯絡頁設定";
}

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
    @Scripts.Render("~/bundles/ckeditor")

    <script>
        CKEDITOR.replace('ContentHtml', {
            filebrowserBrowseUrl: '/Admin/FileManager?type=ContactPage&id=1&tag=HtmlEditorPicture',
            language: 'zh-tw',
            versionCheck: false
        });

        var targetInputId;

        function openPicturePicker(tag, inputId) {
            targetInputId = inputId;
            var url = '/Admin/FileManager'
                + '?type=ContactPage'
                + '&id=1'
                + '&tag=' + tag;

            window.open(url, 'fileManager', 'width=1100,height=700');
        }

        function onFilePicked(path) {
            document.getElementById(targetInputId).value = path;
            document.getElementById('bannerPreview').src = path;
        }
    </script>
}

<h2 class="my-2">@ViewBag.Title</h2>
<p class="text-muted ">
    正在編輯聯絡頁的文本。
</p>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">
        @TempData["Message"]
    </div>
}

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div class="card mb-3">
        <div class="card-header">封面管理</div>
        <div class="card-body">
            <div class="banner-picker-row">
                <input type="hidden" name="ContactBannerPath" value="@Model.ContactBannerPath" id="bannerPathInput" />
                <div class="cover-preview">
                    <img src="@(Model.ContactBannerPath ?? ImageDefaults.Picture)" id="bannerPreview" />
                </div>
                <button type="button" class="btn btn-outline-primary"
                        onclick="openPicturePicker('ContactBannerPicture', 'bannerPathInput')">
                    選擇橫幅圖片
                </button>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">內容（介紹／總公司／業務窗口）</div>
        <div class="card-body">
            @Html.TextAreaFor(model => model.ContentHtml, new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.ContentHtml, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">地圖</div>
        <div class="card-body">
            @Html.TextBoxFor(model => model.MapEmbedUrl, new { @class = "form-control", placeholder = "貼上 Google 地圖 iframe 的 src 網址" })
            @Html.ValidationMessageFor(model => model.MapEmbedUrl, "", new { @class = "text-danger" })

            @if (!string.IsNullOrEmpty(Model.MapEmbedUrl))
            {
                <iframe src="@Model.MapEmbedUrl" class="mt-3" width="100%" height="300" style="border:0;" loading="lazy"></iframe>
            }
        </div>
    </div>

    <div class="form-group my-2">
        <input type="submit" value="儲存" class="btn btn-primary me-1" />
        @Html.ActionLink("回到編輯", "Edit", null, new { @class = "btn btn-outline-secondary" })
    </div>
}