@model TayanaYacht.Models.News.News
@using TayanaYacht.Models;
@{
    ViewBag.Title = "編輯管理";
}

@section scripts {
    @*adminlte*@
    @Scripts.Render("~/bundles/jqueryval")
    @*ckeditor*@
    @Scripts.Render("~/bundles/ckeditor")
    @*bootstrap*@
    @Scripts.Render("~/Content/admin-yacht")


    <script>
        CKEDITOR.replace('ContentHtml', {
            filebrowserBrowseUrl: '/Admin/FileManager?type=News&id=@Model.Id&tag=HtmlEditorPicture',
        language: 'zh-tw',
            versionCheck: false,
            on: {
                instanceReady: function () {
                    if (location.hash === '#files') {
                        document.getElementById('files').scrollIntoView();
                    }
                }
            }
    });
        var targetInputId;
     //按下圖片打開elfinder
        function openPicturePicker(tag, inputId) {
        targetInputId = inputId;
        var url = '/Admin/FileManager'
            + '?type=News'
            + '&id=@Model.Id'
            + '&tag='+tag;

        window.open(url, 'fileManager', 'width=1100,height=700');
    }
    //elfinder回傳圖片路徑
    function onFilePicked(path) {
    var input = document.getElementById(targetInputId);
    input.value = path;
    document.getElementById('coverPreview').src = path;
        }
    </script>
}



<h2 class="my-2">@ViewBag.Title</h2>
<p class="text-muted ">
    正在編輯「@Model.Title」的新聞文本，創建時間 <span class="badge bg-secondary"> @Model.CreatedAt </span> ，上次更新時間 <span class="badge bg-info "> @Model.UpdatedAt </span>
</p>
<div class="my-2">
    @Html.ActionLink("返回列表", "Index", null, new { @class = "btn btn-outline-secondary" })
</div>
@if (TempData["Message"] != null)
{
    <div class="alert alert-success">
        @TempData["Message"]
    </div>
}

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.Id)
    <div class="card mb-3">
        <div class="card-header">封面編輯</div>
        <div class="card-body">
            <div class="banner-picker-row">
                <input type="hidden" name="NewsCoverPath" value="@Model.NewsCoverPath" id="bannerImagePath" />
                <div class="cover-preview">
                    <img src="@(Model.NewsCoverPath ?? ImageDefaults.Picture)" id="coverPreview" />
                </div>
                <button type="button" class="btn btn-primary"onclick="openPicturePicker('NewsCoverPicture', 'bannerImagePath')">選擇Cover圖片</button>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">基本資訊</div>
        <div class="card-body">
            <div class="mb-3">
                @Html.LabelFor(model => model.Title, htmlAttributes: new { @class = "control-label col-md-2" })
                @Html.EditorFor(model => model.Title, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.Summary, htmlAttributes: new { @class = "control-label col-md-2" })
                @Html.EditorFor(model => model.Summary, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Summary, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>
    <div class="card mb-3">
        <div class="card-header">新聞內文</div>
        <div class="card-body">
            <div class="mb-3">
                @Html.LabelFor(model => model.ContentHtml, htmlAttributes: new { @class = "control-label col-md-2" })
                @Html.TextAreaFor(model => model.ContentHtml, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.ContentHtml, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>
    <div class="d-flex gap-2 mb-3">
        <input type="submit" value="儲存" class="btn btn-primary" />
        @Html.ActionLink("返回取消", "Index", null, new { @class = "btn btn-outline-secondary" })
    </div>

}



