@model TayanaYacht.Models.News.News
@using TayanaYacht.Models
@{
    ViewBag.Title = "刪除新聞";
}

<h2 class="my-2">@ViewBag.Title</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-warning">@TempData["Message"]</div>
}

<div class="alert alert-warning">
    確定要刪除這則新聞嗎？刪除後前台不會顯示，後台列表也看不到。
</div>

<div class="card mb-3">
    <div class="card-body d-flex align-items-center gap-3">
        <img class="banner-thumb" src="@(Model.NewsCoverPath ?? ImageDefaults.Picture)" />
        <div>
            <div class="fw-semibold">@Model.Title</div>
            <div class="text-muted small mb-1">@Model.Summary</div>
            @if (Model.UnpublishedAt == null)
            {
                <span class="badge bg-success">上架中</span>
            }
            else
            {
                <span class="badge bg-secondary">未上架</span>
            }
            <span class="text-muted small ms-2">建立於 @Html.DisplayFor(m => m.CreatedAt)</span>
        </div>
    </div>
</div>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-danger">確定刪除</button>
        @Html.ActionLink("返回取消", "Index", null, new { @class = "btn btn-outline-secondary" })
    </div>
}