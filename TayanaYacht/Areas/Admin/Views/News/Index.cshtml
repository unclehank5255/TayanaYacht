@model IEnumerable<TayanaYacht.Models.News.News>
@using TayanaYacht.Models;
@{
    ViewBag.Title = "Index";
}

<h2>Index</h2>

<p>
    @Html.ActionLink("Create New", "Create")
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.NewsCoverPath)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Title)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Summary)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.CreatedAt)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.UpdatedAt)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.IsPublished)
        </th>
        <th>
            狀態
        </th>
        <th>
            @Html.DisplayNameFor(model => model.UnpublishedAt)
        </th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                <img class="banner-thumb" src="@(item.NewsCoverPath ?? ImageDefaults.Picture)" />
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Title)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Summary)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreatedAt)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UpdatedAt)
            </td>
            <td>
                @using (Html.BeginForm("TogglePublish", "News", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@item.Id" />
                    <div>
                        <div>
                            <button type="submit" onclick="return confirm('確定要切換發布狀態嗎？');">
                                @if (item.IsPublished)
                                {
                                    <span>下架 </span>
                                }
                                else
                                {
                                    <span>上架</span>
                                }
                            </button>
                        </div>

                    </div>
                }
            </td>
            <td>
                @if (item.IsPublished)
                {
                    <span>上架中</span>
                }
                else
                {
                    <span>未上架</span>
                }
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UnpublishedAt)
            </td>
            <td>
                @Html.ActionLink("Edit", "Edit", new { id = item.Id }) |
                @Html.ActionLink("Details", "Details", new { id = item.Id }) |
                @Html.ActionLink("Delete", "Delete", new { id = item.Id })
            </td>
        </tr>
    }

</table>
