@model TayanaYacht.Models.ViewModels.YachtPageVM
@{
    ViewBag.Title = "Yacht";
}
<div class="bannermasks"><img src="@Url.Content("~/Content/front/images/banner01_masks.png")" alt="" /></div>

<div class="banner">
    <div id="gallery" class="ad-gallery">
        <div class="ad-image-wrapper">
        </div>
        <div class="ad-controls" style="display:none">
        </div>
        <div class="ad-nav">
            <div class="ad-thumbs">
                <ul class="ad-thumb-list">
                    @foreach (var picture in Model.GalleryPictures)
                    {
                        var imageUrl = Url.Content("~" + picture.ImagePath);
                        <li>
                            <a href="@imageUrl">
                                <img src="@imageUrl" />
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>


<div id="buttom02"> <a href="#"><img src="@Url.Content("~/Content/front/images/buttom02.gif")" alt="next" /></a></div>



<div class="conbg">
    <!--------------------------------左邊選單開始---------------------------------------------------->
    <div class="left">

        <div class="left1">
            <p><span>YACHTS</span></p>
            <ul>
                @foreach (var yacht in Model.Yachts)
                {
                    <li><a href="@Url.Action("Index", "Yachts", new { id = yacht.Id })">@yacht.SeriesName @yacht.ModelName</a></li>
                }
            </ul>



        </div>




    </div>







    <!--------------------------------左邊選單結束---------------------------------------------------->
    <!--------------------------------右邊選單開始---------------------------------------------------->
    <div id="crumb"><a href="#">Home</a> >> <a href="#">Yachts</a> >> <a href="#"><span class="on1">@Model.CurrentYacht.SeriesName @Model.CurrentYacht.ModelName</span></a></div>
    <div class="right">
        <div class="right1">
            <div class="title"> <span>@Model.CurrentYacht.SeriesName @Model.CurrentYacht.ModelName</span></div>

            <!--------------------------------內容開始---------------------------------------------------->
            <!--次選單-->
            <div class="menu_y">
                <ul>
                    <li class="menu_y00">YACHTS</li>
                    <li><a class="menu_yli01" href="@Url.Action("Index", "Yachts", new { id = Model.CurrentYacht.Id})">Overview</a></li>
                    <li><a class="menu_yli02" href="@Url.Action("Index", "Yachts", new { id = Model.CurrentYacht.Id, tab = "layout"})">Layout & deck plan</a></li>
                    <li><a class="menu_yli03" href="@Url.Action("Index", "Yachts", new { id = Model.CurrentYacht.Id, tab = "specification"})">Specification</a></li>
                </ul>
            </div>
            <!--次選單-->

            <div class="box1">
                @Html.Raw(Model.CurrentYacht.OverviewHtml)<br /><br />

            </div>

            <div class="box3">
                <h4>PRINCIPAL DIMENSION</h4>
                @Html.Raw(Model.CurrentYacht.PrincipleDimensionHtml)


            </div>
            <p class="topbuttom"><img src="@Url.Content("~/Content/front/images/top.gif")" alt="top" /></p>

            <!--下載開始-->
            <div class="downloads">
                <p><img src="@Url.Content("~/Content/front/images/downloads.gif")" alt="&quot;&quot;" /></p>
                <ul>
                    @foreach (var file in Model.CurrentYacht.YachtFiles)
                    {
                        <li><a href="@Url.Content("~"+file.FilePath)">@Path.GetFileNameWithoutExtension(@file.FileDisplayName)</a></li>
                    }
                </ul>
            </div>
            <!--下載結束-->
            <!--------------------------------內容結束------------------------------------------------------>
        </div>
    </div>

    <!--------------------------------右邊選單結束---------------------------------------------------->
</div>