@model TayanaYacht.Models.ViewModels.DealerPageVM
@using TayanaYacht.Models;

@section styles {
    <link href="@Url.Content("~/Content/front/css/homestyle.css")" rel="stylesheet" type="text/css" />
}

<div class="bannermasks"><img src="@Url.Content(Model.DealerBannerPath)" alt="" width="967" height="371" /></div>

<div class="banner">
    <ul>
        <li><img src="@Url.Content("~/Content/front/images/newbanner.jpg")" alt="Tayana Yachts" /></li>
    </ul>
</div>

<div class="conbg">
    <div class="left">
        <div class="left1">
            <p><span>DEALERS</span></p>
            <ul>
                @foreach (var country in Model.Countries)
                {
                    <li><a href="@Url.Action("Index", "Dealers", new { id = country.Id })">@country.Name</a></li>
                }
            </ul>
        </div>
    </div>

    <div id="crumb">
        <a href="@Url.Action("Index", "Home")">Home</a> >>
        <a href="@Url.Action("Index", "Dealers")">Dealers</a> >>
        <a href="#"><span class="on1">@(Model.CurrentCountry?.Name)</span></a>
    </div>

    <div class="right">
        <div class="right1">
            <div class="title"><span>@(Model.CurrentCountry?.Name)</span></div>

            <div class="box2_list">
                @if (Model.Dealers.Any())
                {
                    <ul>
                        @foreach (var dealer in Model.Dealers)
                        {
                            <li>
                                <div class="list02">
                                    <ul>
                                        <li class="list02li">
                                            <div><p><img src="@Url.Content(dealer.DealerCoverPath)" alt="" /></p></div>
                                        </li>
                                        <li>
                                            <span>@dealer.City</span><br />
                                            @dealer.Name<br />
                                            @Html.Raw(dealer.ContentHtml)
                                        </li>
                                    </ul>
                                </div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p>No dealers available.</p>
                }
            </div>
        </div>
    </div>
</div>