@model TayanaYacht.Models.ViewModels.NewsVM

@section styles{
    <link href="@Url.Content("~/Content/front/css/homestyle.css")" rel="stylesheet" />

    <style>
        .news-thumbnail-frame {
            width: 150px;
            height: 100px;
            margin: 0;
            overflow: hidden;
        }

        .news-thumbnail {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        .page-banner {
            width: 100%;
            object-fit: cover;
            display: block;
        }
    </style>
}
<!--遮罩-->
<div class="bannermasks"><img src="@Url.Content("~/Content/front/images/banner02_masks.png")" alt="&quot;&quot;" /></div>
<!--遮罩結束-->
<!--------------------------------換圖開始---------------------------------------------------->

<div class="banner">
    <ul>
        <li><img class="banner" src="@Url.Content("~"+Model.NewsBannerPath)" alt="Tayana Yachts" /></li>
    </ul>

</div>
<!--------------------------------換圖結束---------------------------------------------------->




<div class="conbg">
    <!--------------------------------左邊選單開始---------------------------------------------------->
    <div class="left">

        <div class="left1">
            <p><span>NEWS</span></p>
            <ul>
                <li><a href="@Url.Action("Index", "News")">News & Events</a></li>

            </ul>



        </div>




    </div>







    <!--------------------------------左邊選單結束---------------------------------------------------->
    <!--------------------------------右邊選單開始---------------------------------------------------->
    <div id="crumb"><a href="#">Home</a> >> <a href="#">News </a> >> <a href="#"><span class="on1">News & Events</span></a></div>
    <div class="right">
        <div class="right1">
            <div class="title"> <span>News & Events</span></div>

            <!--------------------------------內容開始---------------------------------------------------->

            <div class="box2_list">
                <ul>
                    @foreach (var news in Model.NewsList)
                    {
                        <li>
                            <div class="list01">
                                <ul>

                                    <li><a href="@Url.Action("Details","News", new { id = news.Id})"><div><p class="news-thumbnail-frame"><img class="news-thumbnail" src="@Url.Content("~"+news.NewsCoverPath)" alt="&quot;&quot;" /></p></div></a></li>

                                    <li>
                                        <span>@(news.PublishDate?.ToString("yyyy-MM-dd"))</span><br />
                                        <a href="@Url.Action("Details","News", new { id = news.Id})">
                                            @news.Title
                                        </a><br />
                                    </li>
                                    <li>@news.Summary</li>
                                </ul>
                            </div>
                        </li>
                    }
                </ul>
                @if (Model.NewsList.Any())
                {
                    <div class="pagenumber">

                        @for (int i = Model.StartPage; i <= Model.EndPage; i++)
                        {
                            @:|
                            if (i == Model.CurrentPage)
                            {
                                <span>@i</span>
                            }
                            else
                            {
                                <a href="@Url.Action("Index", "News", new { page = i })">@i</a>
                            }
                        }
                        |

                        @if (Model.CurrentPage == 1)
                        {
                            <span class="disabled">Prev</span>
                        }
                        else
                        {
                            <a href="@Url.Action("Index", "News", new { page = Model.CurrentPage -1 })">Prev</a>
                        }
                        @if (Model.CurrentPage == Model.TotalPages)
                        {
                            <span class="disabled">Next</span>
                        }
                        else
                        {
                            <a href="@Url.Action("Index", "News", new { page = Model.CurrentPage + 1 })">Next</a>
                        }
                        <a href="@Url.Action("Index", "News", new { page = Model.TotalPages })">LastPage</a>
                    </div>
                    <div class="pagenumber1"> Items：<span>@Model.TotalCount</span>  |  Pages：<span>@Model.CurrentPage/@Model.TotalPages</span></div>
                }
                else
                {
                    <p>No news available.</p>
                }
            </div>
            <!--------------------------------內容結束------------------------------------------------------>
        </div>
    </div>

    <!--------------------------------右邊選單結束---------------------------------------------------->
</div>
